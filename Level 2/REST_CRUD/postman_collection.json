{
  "info": {
    "name": "REST_CRUD - Users & Auth API",
    "description": "Postman collection for Users and Auth API endpoints. Configure the base_url variable to match your nginx reverse proxy setup (e.g., http://localhost or your domain).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "rest_crud"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost",
      "description": "Base URL for the API (nginx reverse proxy). Change to your domain if deployed.",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "description": "JWT token from login/signup. Auto-populated after authentication.",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "description": "User ID for testing individual user endpoints. Set after creating/getting a user.",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
